# Copia este archivo a `.env` y ajusta los valores. `.env` está en .gitignore.

# local | demo | production
FROBI_ENVIRONMENT=local

# Postgres y Redis de docker/compose.yml (puertos publicados en localhost)
FROBI_DATABASE_URL=postgresql+asyncpg://frobi:frobi@localhost:5432/frobi
FROBI_REDIS_URL=redis://localhost:6379/0

# Orígenes del front separados por coma (sin barra final)
FROBI_CORS_ORIGINS=http://localhost:5173

# Proveedor de IA. Sin clave, cada llamada usa su respaldo y responde `fallback: true`.
#   anthropic: API de Anthropic (Claude). Modelo por defecto: claude-haiku-5-5.
#   openai:    cualquier API compatible con OpenAI (OpenAI, Groq, OpenRouter, Gemini, Ollama).
#              Exige FROBI_LLM_MODEL; FROBI_LLM_BASE_URL apunta al proveedor.
FROBI_LLM_PROVIDER=anthropic
FROBI_LLM_API_KEY=
FROBI_LLM_MODEL=
FROBI_LLM_BASE_URL=
FROBI_LLM_TIMEOUT_SECONDS=15

# Calls per person per minute before answers come from the fallback
FROBI_LLM_REQUESTS_PER_MINUTE=10
