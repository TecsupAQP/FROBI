# Copia este archivo a deploy/.env en el VPS y llénalo. deploy/.env NUNCA se sube al repo.

# Dominio que apunta a la IP del VPS (registro A). Con dominio, Caddy saca HTTPS solo.
# Déjalo vacío para servir por http con la IP del VPS.
FROBI_DOMAIN=

# Contraseña de Postgres: larga y aleatoria. No la cambies después de la primera vez
# (la base ya quedó creada con ella).
POSTGRES_PASSWORD=

# demo: habilita el acceso demo (POST /sessions/demo). production: lo apaga.
FROBI_ENVIRONMENT=demo

# Origen del front si alguna vez lo sirves en otro dominio (separados por coma).
# Con este compose el front y la API comparten dominio y no hace falta.
FROBI_CORS_ORIGINS=

# IA con la API de Claude. Sin clave, FROBI responde con sus respaldos.
FROBI_LLM_PROVIDER=anthropic
FROBI_LLM_API_KEY=
# Opcional: por defecto claude-haiku-5-5.
FROBI_LLM_MODEL=
FROBI_LLM_BASE_URL=
