{
  "components": {
    "schemas": {
      "ComponentStatus": {
        "enum": [
          "up",
          "down"
        ],
        "title": "ComponentStatus",
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ComponentStatus"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InvalidParam": {
        "properties": {
          "loc": {
            "description": "Ruta al campo inválido, por ejemplo ['body', 'alias'].",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "InvalidParam",
        "type": "object"
      },
      "ProblemDetail": {
        "properties": {
          "code": {
            "description": "Código estable para el front, por ejemplo 'Tutoring.FinalLocked'.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/InvalidParam"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Solo en 422: un elemento por campo inválido.",
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetail",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Backend de FROBI (Hack4Edu 2026). Los errores siguen RFC 9457 (`application/problem+json`) con un `code` estable.",
    "title": "FROBI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Datos inválidos (`Validation.Invalid`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Alguna dependencia no responde."
          }
        },
        "summary": "Estado de la API, Postgres y Redis",
        "tags": [
          "health"
        ]
      }
    }
  }
}
